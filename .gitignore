# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore private keys / PEM files
*.pem
*.key

# .terraform.lock.hcl can be included or ignored (recommended to include if you want strict version locking, but can be ignored)
#.terraform.lock.hcl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
